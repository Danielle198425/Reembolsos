{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/exports/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|uploads/|exports/|static/).*)",
      "destination": "/index.html"
    }
  ]
}

{
  "crons": [
    {
      "path": "/api/cron/friday-pending-approvals",
      "schedule": "0 12 * * 5"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/static/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/static/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/manifest.json",
      "destination": "/static/manifest.json"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/api/cron/(.*)",
      "destination": "/api/index.py?__path=api/cron/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.py?__path=uploads/$1"
    },
    {
      "source": "/exports/(.*)",
      "destination": "/api/index.py?__path=exports/$1"
    },
    {
      "source": "/((?!api/|uploads/|exports/|static/|sw\\.js|manifest\\.json).*)",
      "destination": "/index.html"
    }
  ]
}

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/reembolsos

# JWT Secret
SECRET_KEY=sua_chave_secreta_jwt_aqui

# Microsoft Entra ID (Azure AD) - Autenticação SSO
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=seu_azure_client_secret_aqui
AZURE_REDIRECT_URI=https://seu-dominio.vercel.app/api/auth/azure/callback

# Azure AI Document Intelligence (Reconhecimento Inteligente de Recibos/Comprovantes)
# Autenticação sem chave estática via DefaultAzureCredential (Microsoft Entra ID)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://seu-recurso.cognitiveservices.azure.com/

# Azure Maps (Geocoding, Autocomplete de Endereços e Cálculo de Rotas de Quilometragem)
# Autenticação sem chave estática via DefaultAzureCredential (Microsoft Entra ID)
AZURE_MAPS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Sienge API
SIENGE_SUBDOMAIN=mouraleite
SIENGE_API_USER=seu_usuario_sienge
SIENGE_API_PASSWORD=sua_senha_sienge

